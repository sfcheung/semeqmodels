```{r}
# Set the layout of the plots
m <- matrix(
  c(  NA, "fm",   NA,
    "fx",   NA, "fy"),
  nrow = 2,
  ncol = 3,
  byrow = TRUE)
m
```

We can then generate the plots:

```{r}
p <- partables_plots(
  out,
  original_model = fit,
  layout = m,
  label.cex = 1.5,
  sizeMan = 11,
  edge.width = 5,
  asize = 5
)
```

```{r load_plotmodels, child=c("demo_ins_plotmodels.txt")}
```


```{r demo_obs_3_eqmodels, fig.width = 10, fig.height = 6, echo = TRUE, fig.cap = "Empirically Equivalent Models"}
plot(
  p,
  ncol = 5,
  nrow = 3,
  title_adj = 2
)
```

